macos-option-as-alt = true

mouse-hide-while-typing = true

clipboard-read = allow
clipboard-write = allow

desktop-notifications = true

background-blur-radius = 20

window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

cursor-color = "#c0c0c0"
cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor

theme = "Kanagawabones"

font-family = "Lilex"
# Fallback font (Handles glyphs missing in Lilex, e.g., CJK characters)
font-family = "HackGen Console NF"

font-size = 14

font-feature = "-dlig"

keybind = super+d=new_split:right

keybind = super+shift+d=new_split:down

keybind = super+left=goto_split:left
keybind = super+right=goto_split:right
keybind = super+up=goto_split:top
keybind = super+down=goto_split:bottom

keybind = super+z=toggle_split_zoom

keybind = global:cmd+backquote=toggle_quick_terminal
