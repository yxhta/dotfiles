#!/bin/sh
set -eu

# Pick a Rex pane whose program reports a status (Claude Code, Codex, ...) and focus it.
list=$(
  rex do - <<'EOF'
for _, s in ipairs((rex.call("session.list") or {}).sessions or {}) do
  for _, b in ipairs((rex.session.list_blocks({ session_id = s.session_id }) or {}).blocks or {}) do
    local args = { session_id = s.session_id, block_id = b.block_id }
    args.method = "program_status"
    local status = rex.call("block.method", args)
    local r = status and status.records and status.records[1]
    if r and r.app then
      args.method = "process"
      local p = rex.call("block.method", args)
      local cwd = (p and p.foreground and p.foreground.cwd or ""):gsub("^" .. os.getenv("HOME"), "~")
      print(table.concat({ b.block_id, r.app, r.state or "", s.label or "", cwd }, "\t"))
    end
  end
end
EOF
)

if [ -z "$list" ]; then
  echo "No AI sessions found in Rex" >&2
  sleep 1
  exit 0
fi

pick=$(printf '%s\n' "$list" | fzf --delimiter='	' --with-nth=2.. --reverse \
  --header="enter: focus" \
  --preview 'rex capture -b {1} --trim | tail -n 80' \
  --preview-window='right:60%:wrap:follow') || exit 0

rex focus "${pick%%	*}"
