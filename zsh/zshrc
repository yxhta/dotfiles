for fn in "$HOME/.zsh/functions/"*(N-.); do
  [[ "$fn" == *.md ]] && continue
  source "$fn"
done

_load_settings() {
  local dir="$1"
  local config

  if [ -d "$dir" ]; then
    if [ -d "$dir/pre" ]; then
      for config in "$dir"/pre/**/*(N-.); do
        source "$config"
      done
    fi

    for config in "$dir"/**/*(N-.); do
      case "$config" in
        "$dir"/(pre|post)/*|*.zwc|*.md)
          ;;
        *)
          source "$config"
          ;;
      esac
    done

    if [ -d "$dir/post" ]; then
      for config in "$dir"/post/**/*(N-.); do
        source "$config"
      done
    fi
  fi
}

_load_settings "$HOME/.zsh/configs"
export PATH=$PATH:$HOME/.maestro/bin

# herdr-projects
export PATH="$HOME/.herdr-projects/data/bin:$PATH"
